#!/bin/zsh
# Fetches the macOS arm64 toolchain Slipstream embeds beside its core (ffmpeg, ffprobe, fc-list,
# whisper-cli, versions.txt, fonts/ with Inter and fonts.conf, licenses/) from kyrios/encode-queue's
# release toolchain-<N> into build/tools (docs/tools.md). One build, encode-queue's, runs on the
# server and on the Mac. The core itself is built from core/ by bin/package.
#
# The release and the tarball's sha256 are pinned here. Anything else fails: a replaced asset
# stops the build instead of shipping. A new toolchain is a change to these lines.
#   bin/fetch-tools
set -euo pipefail
cd "${0:A:h}/.."
repo=kyrios/encode-queue
tag=toolchain-3
toolchain=encode-toolchain-darwin-arm64.tar.gz
toolchain_sha256=398d930ee38df4a54a2e2cacae7a8a8f4199baf2d56db703177fb2676dc8fece

rm -rf build/tools build/fetch
mkdir -p build/tools build/fetch
gh release download "$tag" -R $repo -D build/fetch -p $toolchain
cd build/fetch
print -r -- "$toolchain_sha256  $toolchain" | shasum -a 256 -c
tar xzf $toolchain -C ../tools --strip-components 1
cd ..
rm -rf fetch

for f in tools/ffmpeg tools/ffprobe tools/fc-list tools/whisper-cli; do
  [[ -x $f ]] || { print "missing in $tag: $f" >&2; exit 1; }
  file $f | grep -q 'Mach-O 64-bit executable arm64' || { print "$f is not a macOS arm64 binary" >&2; exit 1; }
done
[[ -f tools/versions.txt ]] || { print "missing in $tag: versions.txt" >&2; exit 1; }
# Toolchain 3: the captions' fonts, the only ones libass sees (docs/tools.md, "Captions").
[[ -f tools/fonts/fonts.conf && -f tools/fonts/Inter-ExtraBold.ttf ]] || { print "missing in $tag: fonts/" >&2; exit 1; }
# The tarball carries each component's licence and SOURCES.md.
[[ -s tools/licenses/SOURCES.md ]] || { print "missing in $tag: licenses/SOURCES.md" >&2; exit 1; }
print "licences: $(ls tools/licenses | tr '\n' ' ')"
cat tools/versions.txt
tools/ffmpeg -hide_banner -version | head -1
