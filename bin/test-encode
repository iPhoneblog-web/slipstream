#!/bin/zsh
# The end-to-end check on a real-size file: makes a 4K ProRes 422 HQ sample with ffmpeg (60 s,
# 25 fps, Rec. 709, PCM stereo, a timecode track: what Final Cut exports), runs the app's intermediate
# through slipstream-cli, and checks the result with ffprobe and AVFoundation, the framework
# QuickTime Player plays with. SHOW=yes also opens it in QuickTime Player to look at.
#   bin/test-encode [work-dir] [seconds]
# The sample is about 6 GB a minute; the work directory keeps it for the next run.
set -euo pipefail
cd "${0:A:h}/.."
work=${1:-${TMPDIR:-/tmp}/slipstream-test}
secs=${2:-60}
mkdir -p "$work"
src="$work/sample-4k25-${secs}s.mov"
outdir="$work/out"

if [[ ! -s "$src" ]]; then
  echo "== making $src"
  ffmpeg -hide_banner -loglevel error -y \
    -f lavfi -i "testsrc2=size=3840x2160:rate=25:duration=$secs,noise=alls=6:allf=t+u,format=yuv422p10le,setparams=color_primaries=bt709:color_trc=bt709:colorspace=bt709:range=tv" \
    -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=$secs" \
    -f lavfi -i "sine=frequency=660:sample_rate=48000:duration=$secs" \
    -filter_complex "[1:a][2:a]amerge=inputs=2[a]" -map 0:v -map "[a]" \
    -c:v prores_videotoolbox -profile:v hq -c:a pcm_s24le -timecode 01:00:00:00 "$src"
fi

swift build -c release --product slipstream-cli >/dev/null
rm -rf "$outdir"
mkdir -p "$outdir"
echo "== encoding on $(sysctl -n machdep.cpu.brand_string), macOS $(sw_vers -productVersion)"
report=$(.build/release/slipstream-cli "$src" --out "$outdir" 2>/dev/null)
print -r -- "$report"
out=$(print -r -- "$report" | python3 -c 'import json,sys; print(json.load(sys.stdin)["output"])')

echo "== source"
ffprobe -v error -show_entries stream=index,codec_name,codec_tag_string,profile,width,height,r_frame_rate,pix_fmt,color_primaries,color_transfer,color_space,sample_rate,channels:format=duration,size,bit_rate -of compact "$src"
echo "== output"
ffprobe -v error -show_entries stream=index,codec_name,codec_tag_string,profile,width,height,r_frame_rate,pix_fmt,color_primaries,color_transfer,color_space,bit_rate,duration,nb_frames,sample_rate,channels,channel_layout:format=duration,size,bit_rate -of compact "$out"
echo "== top-level boxes"
boxes=$(ffprobe -v trace "$out" 2>&1 | grep "parent:'root'" | sed -E "s/.*type:'([a-z]{4})'.*/\1/" | tr '\n' ' ')
echo "$boxes"

fail=0
check() { if eval "$2"; then echo "ok    $1"; else echo "FAIL  $1"; fail=1; fi }
v() { ffprobe -v error -select_streams v:0 -show_entries "stream=$1" -of csv=p=0 "$out"; }
fmt() { ffprobe -v error -show_entries "format=$1" -of csv=p=0 "$2"; }
check "codec hevc, tag hvc1"       '[[ "$(v codec_name,codec_tag_string)" == "hevc,hvc1" ]]'
check "profile Main 10, 10 bit"    '[[ "$(v profile,pix_fmt)" == "Main 10,yuv420p10le" ]]'
check "3840x2160 at 25 fps"        '[[ "$(v width,height,r_frame_rate)" == "3840,2160,25/1" ]]'
check "Rec. 709 tags kept"         '[[ "$(v color_primaries,color_transfer,color_space)" == "bt709,bt709,bt709" ]]'
check "index in front (moov before mdat)" '[[ "$boxes" == *moov*mdat* ]]'
check "whole file about 50 Mbit/s, at most 60" '(( $(fmt bit_rate "$out") <= 60000000 ))'
check "duration equals the source" '[[ "$(fmt duration "$out")" == "$(fmt duration "$src")" ]]'
check "AAC stereo, 48 kHz"         '[[ "$(ffprobe -v error -select_streams a:0 -show_entries stream=codec_name,channels,sample_rate -of csv=p=0 "$out")" == "aac,48000,2" ]]'
swift "tools/playable.swift" "$out" >"$work/playable.txt" 2>&1 || true
check "AVFoundation plays it, first and last frame decode ($(cat "$work/playable.txt"))" '[[ "$(cat "$work/playable.txt")" == "playable 3840x2160 3840x2160" ]]'
if [[ "${SHOW:-}" == yes ]]; then open -a "QuickTime Player" "$out"; fi
exit $fail
