#!/bin/zsh
# Builds Slipstream.app for Apple Silicon and packs it for download:
#   bin/package            tests, build, dist/Slipstream.dmg, dist/Slipstream.zip, dist/SHA256SUMS
#   bin/package --no-test  build only
# Signs ad hoc unless SIGN_IDENTITY names an identity in the keychain (CI: "Developer ID
# Application"). With NOTARY_KEY (path to the App Store Connect .p8), NOTARY_KEY_ID and
# NOTARY_ISSUER it also notarises and staples the app and the disk image (docs/release.md).
# The worker (build/worker) and its tools (build/tools) come from encode-queue's release
# (bin/fetch-worker) when they are there; without them the app runs ProRes only.
# The version is the last tag `v…` (0.0.0 before the first), the build number the commit count.
set -euo pipefail
cd "${0:A:h}/.."

test=1
for a in "$@"; do
  case $a in
    --no-test) test=0 ;;
    *) print "unknown option $a" >&2; exit 64 ;;
  esac
done
name=Slipstream
if (( test )); then
  swift test
fi

version=$(git describe --tags --abbrev=0 --match 'v*.*.*' 2>/dev/null | sed 's/^v//' || true)
version=${version:-0.0.0}
build=$(git rev-list --count HEAD 2>/dev/null || echo 1)
identity=${SIGN_IDENTITY:--}

xcodegen generate --quiet
xcodebuild -project Slipstream.xcodeproj -scheme Slipstream -configuration Release -derivedDataPath build/dd \
  MARKETING_VERSION="$version" CURRENT_PROJECT_VERSION="$build" -quiet build
swift build -c release --arch arm64 --product slipstream-cli
cli_dir=$(swift build -c release --arch arm64 --show-bin-path)

app="dist/Slipstream.app"
appex="$app/Contents/PlugIns/Slipstream Extension.appex"
rm -rf dist
mkdir -p dist
ditto build/dd/Build/Products/Release/Slipstream.app "$app"
sed -i '' "s/\"version\": \"0.0.0\"/\"version\": \"$version\"/" "$appex/Contents/Resources/manifest.json"
plutil -lint "$app/Contents/Info.plist" "$appex/Contents/Info.plist" >/dev/null
python3 -I -c 'import json,sys; json.load(open(sys.argv[1]))' "$appex/Contents/Resources/manifest.json"


# Contents/Helpers: the ProRes encode (always), the worker and its tools (when built).
helpers="$app/Contents/Helpers"
mkdir -p "$helpers"
cp "$cli_dir/slipstream-cli" "$helpers/"
for f in build/tools/ffmpeg build/tools/ffprobe build/tools/whisper-cli build/worker/encode-worker; do
  [[ -f $f ]] && cp "$f" "$helpers/"
done
# Data is no code: codesign takes only executables in Contents/Helpers.
for f in build/tools/versions.txt build/tools/versions.json; do
  [[ -f $f ]] && cp "$f" "$app/Contents/Resources/"
done
# REQUIRE_WORKER=1 (CI) refuses the ProRes-only fallback.
if [[ -x "$helpers/encode-worker" && -x "$helpers/ffmpeg" && -x "$helpers/whisper-cli" ]]; then
  print "embedded: encode-worker $("$helpers/encode-worker" --version), $(head -1 "$app/Contents/Resources/versions.txt"), $("$helpers/ffmpeg" -hide_banner -version | head -1 | cut -d' ' -f1-3)"
elif [[ -n ${REQUIRE_WORKER:-} ]]; then
  print "no worker or tools in build/: run bin/fetch-worker" >&2
  exit 1
else
  print "embedded: no worker, ProRes only"
fi
# Without debug symbols a binary carries no build paths, so no user name of the Mac it was
# built on.
for f in "$helpers"/*(.x) "$app/Contents/MacOS/Slipstream" "$appex/Contents/MacOS/Slipstream Extension"; do
  strip -S -x "$f" 2>/dev/null || true
done

# Inside out: the helpers, the extension, the app. Hardened runtime everywhere; a secure
# timestamp with a real identity, none ad hoc.
if [[ $identity == - ]]; then ts=(--timestamp=none); else ts=(--timestamp); fi
sign() { codesign --force --sign "$identity" --options runtime "${ts[@]}" "$@"; }
for f in "$helpers"/*(.x); do sign "$f"; done
sign --entitlements Extension/SlipstreamExtension.entitlements "$appex"
sign --entitlements App/Slipstream/Slipstream.entitlements "$app"
codesign --verify --strict --deep --verbose=2 "$app"
# Safari runs no extension without its sandbox, and the extension finds the app only through
# the app group (xcodegen once wrote both entitlements files empty).
codesign -d --entitlements - --xml "$appex" 2>/dev/null | grep -q com.apple.security.app-sandbox
# And the Info.plists: the extension point, a menu bar app, this version (xcodegen once wrote
# them from its defaults).
[[ $(plutil -extract NSExtension.NSExtensionPointIdentifier raw "$appex/Contents/Info.plist") == com.apple.Safari.web-extension ]]
[[ $(plutil -extract LSUIElement raw "$app/Contents/Info.plist") == true ]]
[[ $(plutil -extract CFBundleShortVersionString raw "$app/Contents/Info.plist") == "$version" ]]
for b in "$appex" "$app"; do
  codesign -d --entitlements - --xml "$b" 2>/dev/null | grep -q W9N692KH39.io.github.kyrios.slipstream
done

# Apple's ticket service drops connections from CI runners now and then (error 68, "The network
# connection was lost"); the stapler tries again.
again() { for i in 1 2 3 4 5; do "$@" && return 0; print "retry $i: $*" >&2; sleep 20; done; return 1; }
notarise() {  # file
  xcrun notarytool submit "$1" --key "$NOTARY_KEY" --key-id "$NOTARY_KEY_ID" --issuer "$NOTARY_ISSUER" \
    --wait --timeout 30m --output-format json | tee dist/notary.json
  python3 -I -c 'import json,sys; s=json.load(open(sys.argv[1]))["status"]; print(s); sys.exit(s != "Accepted")' dist/notary.json
}
if [[ -n ${NOTARY_KEY:-} ]]; then
  ditto -c -k --keepParent "$app" dist/notarise.zip
  notarise dist/notarise.zip
  rm dist/notarise.zip
  again xcrun stapler staple "$app"
fi

# The disk image: the app and a link to /Applications, to drag it across.
stage="dist/dmg"
mkdir -p "$stage"
ditto "$app" "$stage/Slipstream.app"
ln -s /Applications "$stage/Programme"
hdiutil create -quiet -volname "$name $version" -srcfolder "$stage" -fs HFS+ -format UDZO -ov dist/$name.dmg
rm -rf "$stage"
if [[ $identity != - ]]; then codesign --force --sign "$identity" --timestamp dist/$name.dmg; fi
if [[ -n ${NOTARY_KEY:-} ]]; then
  notarise dist/$name.dmg
  again xcrun stapler staple dist/$name.dmg
  again xcrun stapler validate dist/$name.dmg
  spctl -a -vv -t open --context context:primary-signature dist/$name.dmg
  rm -f dist/notary.json
fi
hdiutil verify -quiet dist/$name.dmg

(cd dist && ditto -c -k --sequesterRsrc --keepParent Slipstream.app $name.zip)
(cd dist && shasum -a 256 $name.dmg $name.zip > SHA256SUMS)
echo "version $version, build $build, signed by ${identity/-/ad hoc}"
cat dist/SHA256SUMS
