#!/bin/zsh
# Fetches what Slipstream embeds from kyrios/encode-queue's release: the worker's macOS arm64
# binary into build/worker/encode-worker, and the macOS arm64 toolchain (ffmpeg, ffprobe,
# whisper-cli, versions.txt) into build/tools (docs/worker.md, docs/tools.md). One build,
# encode-queue's, runs on encoder and on the Mac.
#
# The tag and both files' sha256 are pinned here. Anything else fails: a moved tag or a
# replaced asset stops the build instead of shipping. A new worker is a change to these lines.
#   bin/fetch-worker
set -euo pipefail
cd "${0:A:h}/.."
repo=kyrios/encode-queue
tag=v0.2.1
worker=encode-worker-darwin-arm64
worker_sha256=25aa9ca766d3d89347d12494abec4a4b798adbbab16bf09cf762b3689a9493d1
toolchain=encode-toolchain-darwin-arm64.tar.gz
toolchain_sha256=ee98e4a86c1fe18c9acc02f1cb064d1cda869cce6fdeb2c02760351ba65125ae

rm -rf build/worker build/tools build/fetch
mkdir -p build/worker build/tools build/fetch
gh release download "$tag" -R $repo -D build/fetch -p $worker -p $toolchain
cd build/fetch
print -r -- "$worker_sha256  $worker
$toolchain_sha256  $toolchain" | shasum -a 256 -c

mv $worker ../worker/encode-worker
chmod +x ../worker/encode-worker
tar xzf $toolchain -C ../tools --strip-components 1
cd ..
rm -rf fetch

for f in worker/encode-worker tools/ffmpeg tools/ffprobe tools/whisper-cli; do
  [[ -x $f ]] || { print "missing in $tag: $f" >&2; exit 1; }
  file $f | grep -q 'Mach-O 64-bit executable arm64' || { print "$f is not a macOS arm64 binary" >&2; exit 1; }
done
[[ -f tools/versions.txt ]] || { print "missing in $tag: versions.txt" >&2; exit 1; }
print "embedding encode-queue $tag: $(worker/encode-worker --version)"
cat tools/versions.txt
tools/ffmpeg -hide_banner -version | head -1
