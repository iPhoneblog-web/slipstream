#!/bin/zsh
# Fetches what Slipstream embeds from kyrios/encode-queue's release, checked against its
# SHA256SUMS: the worker's macOS arm64 binary into build/worker/encode-worker, and the macOS
# arm64 toolchain (ffmpeg, ffprobe, whisper-cli at encoder's versions) into build/tools
# (docs/worker.md, docs/tools.md). One build, encode-queue's, runs on encoder and on the Mac.
# Without that release, or without an asset in it, it says so and exits 0: the app then runs
# ProRes only.
#   bin/fetch-worker [tag]    default v0.1.0
set -euo pipefail
cd "${0:A:h}/.."
tag=${1:-v0.1.0}
repo=kyrios/encode-queue
rm -rf build/worker build/tools build/fetch
mkdir -p build/worker build/tools build/fetch
if ! gh release view "$tag" -R $repo >/dev/null 2>&1; then
  print "no release $tag of $repo yet: building without the worker and its tools"
  exit 0
fi
cd build/fetch
gh release download "$tag" -R $repo -p '*darwin*arm64*' -p 'SHA256SUMS*' -p '*checksums*'
sums=(SHA256SUMS*(N) *checksums*(N))
if (( ${#sums} == 0 )); then
  print "release $tag has no checksums; refusing its files" >&2
  exit 1
fi
for f in $sums; do shasum -a 256 -c --ignore-missing "$f"; done

unpack() {  # archive dir
  case $1 in
    *.tar.gz|*.tgz) tar xzf "$1" -C "$2" ;;
    *.tar.xz) tar xJf "$1" -C "$2" ;;
    *.zip) ditto -x -k "$1" "$2" ;;
    *) cp "$1" "$2/" ;;
  esac
}
for a in *darwin*arm64*(N); do
  if [[ $a == *tool* ]]; then unpack "$a" ../tools; else unpack "$a" ../worker; fi
done

# Flatten: the files the app expects, wherever the archive put them.
cd ..
w=$(find worker -type f -name 'encode-worker*' ! -name '*.tar*' ! -name '*.zip' | head -1)
if [[ -n $w && $w != worker/encode-worker ]]; then mv "$w" worker/encode-worker; fi
for t in ffmpeg ffprobe whisper-cli versions.txt; do
  f=$(find tools -type f -name $t | head -1)
  if [[ -n $f && $f != tools/$t ]]; then mv "$f" tools/$t; fi
done
find worker tools -mindepth 1 -type d -empty -delete
rm -rf fetch

for f in worker/encode-worker tools/ffmpeg tools/ffprobe tools/whisper-cli; do
  if [[ -f $f ]]; then
    chmod +x $f
    file $f | grep -q 'Mach-O 64-bit executable arm64' || { print "$f is not a macOS arm64 binary" >&2; exit 1; }
    print "$f"
  else
    print "missing in $tag: $f"
  fi
done
[[ -x worker/encode-worker ]] && worker/encode-worker --version || true
[[ -x tools/ffmpeg ]] && tools/ffmpeg -hide_banner -version | head -1 || true
if [[ -x tools/ffmpeg && ! -f tools/versions.txt ]]; then
  tools/ffmpeg -hide_banner -version | head -1 > tools/versions.txt
fi
